# Copie para .env e preencha. O .env NÃO vai pro git (.gitignore).
# Cada integração é independente: deixe vazio o que não for usar.

# ─── DocuSign (JWT Grant) ─────────────────────────────────────────────────────
# Integration Key (a mesma para todas as contas)
DS_INTEGRATION_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# User ID (GUID do admin que deu consentimento JWT)
DS_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Caminho da chave RSA dentro do container (não mude — coloque o .pem em /secrets/)
DS_RSA_KEY_PATH=/secrets/docusign.pem

# Contas DocuSign (Account ID + Nome + Base URI).
# IMPORTANTE:
#  - DS_ACCOUNT_ID_* é o **GUID** da conta (apiAccountId), não o número curto.
#  - DS_BASE_URI_* é o pod onde a conta vive (na2/na3/na4/eu/...). Pegue o valor
#    certo de cada conta no `userinfo` do JWT ou em DocuSign Admin → Apps and Keys.
#    Usar o pod errado dá erro "INVALID_USERID" na API por conta.
DS_ACCOUNT_ID_1=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DS_ACCOUNT_NAME_1=Conta 1
DS_BASE_URI_1=https://na2.docusign.net

DS_ACCOUNT_ID_2=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DS_ACCOUNT_NAME_2=Conta 2
DS_BASE_URI_2=https://na2.docusign.net

DS_ACCOUNT_ID_3=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DS_ACCOUNT_NAME_3=Conta 3
DS_BASE_URI_3=https://na2.docusign.net

DS_ACCOUNT_ID_4=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DS_ACCOUNT_NAME_4=Conta 4
DS_BASE_URI_4=https://na2.docusign.net

# ─── Microsoft 365 / Graph ────────────────────────────────────────────────────
# App registration no Azure AD (Entra ID) com permissões de APLICAÇÃO:
# User.Read.All + Organization.Read.All (ou Directory.Read.All), com consentimento
# de admin. MS_CLIENT_SECRET é o "Value" do secret (não o "Secret ID").
# Deixe vazio para desativar a integração.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ─── Alertas de licença (Google Chat) ────────────────────────────────────────
# Webhook de entrada do Google Chat: no espaço desejado → "Apps e integrações" →
# "Webhooks" → adicionar → copie a URL. O backend posta um aviso quando o DocuSign
# ou um SKU do M365 chega perto/acima do limite (rodado no sync diário das 05h).
# Deixe vazio para desativar as notificações.
GOOGLE_CHAT_WEBHOOK_URL=
# Percentual de uso a partir do qual alerta (padrão 90). Ex.: 90 avisa aos 225/250.
ALERT_THRESHOLD_PCT=90
# Por padrão o alerta de limite é só do DocuSign. Coloque true para incluir SKUs do M365.
ALERT_INCLUDE_M365=false

# ─── Google Workspace (Apps Script) ──────────────────────────────────────────
# URL de um Google Apps Script publicado como Web App (termina em /exec) que
# retorna os usuários do Workspace em JSON. O código de referência está em
# google_apps_script.gs (na raiz do repo). Deixe vazio para desativar.
GOOGLE_APPS_SCRIPT_URL=
