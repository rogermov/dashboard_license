# ─── DocuSign JWT Grant ────────────────────────────────────────────────────────
# Integration Key (mesma para todas as contas)
DS_INTEGRATION_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# User ID (GUID do admin que deu consentimento)
DS_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Caminho da chave RSA dentro do container (não mude — coloque o .pem em /secrets/)
DS_RSA_KEY_PATH=/secrets/docusign.pem

# ─── Contas DocuSign (Account ID + Nome + Base URI) ───────────────────────────
# Para pegar o Account ID e Base URI: DocuSign Admin → Configurações da conta
# Base URI exemplo: https://na3.docusign.net  (pegar no painel de cada conta)

DS_ACCOUNT_ID_1=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DS_ACCOUNT_NAME_1=Viação Piracicabana
DS_BASE_URI_1=https://na3.docusign.net

DS_ACCOUNT_ID_2=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DS_ACCOUNT_NAME_2=MetroBH
DS_BASE_URI_2=https://na3.docusign.net

DS_ACCOUNT_ID_3=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DS_ACCOUNT_NAME_3=Tic Trens
DS_BASE_URI_3=https://na3.docusign.net

DS_ACCOUNT_ID_4=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DS_ACCOUNT_NAME_4=Trivia Trens
DS_BASE_URI_4=https://na3.docusign.net
